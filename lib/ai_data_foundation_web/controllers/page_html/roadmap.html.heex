<!-- AI Data Foundation Roadmap Hero -->
<section class="kube-roadmap-hero">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="kube-roadmap-hero-copy">
      <span class="kube-kicker">Editorial Curriculum</span>
      <h1>
        1,000 practical titles for the <span>AI &amp; LLM ecosystem.</span>
      </h1>
      <p>
        A structured, public curriculum covering foundational math, transformer architectures, agentic protocols, vector data engineering, and evaluation benchmarks.
      </p>

      <div class="kube-roadmap-stats">
        <div>
          <strong>{@blog_count}</strong>
          <span>Planned Guides</span>
        </div>
        <div>
          <strong>{@lab_count}</strong>
          <span>Security Labs</span>
        </div>
        <div>
          <strong>{length(@roadmap)}</strong>
          <span>Core Tracks</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Roadmap Tracks Accordion -->
<section class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
  <div class="kube-tools-directory-heading flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="kube-kicker">Structured Progression</span>
      <h2 class="text-3xl font-black tracking-tight text-slate-900 [data-theme=dark]:text-white mt-1">
        One Ecosystem. Clear Learning Tracks.
      </h2>
    </div>
    <p class="text-sm text-slate-500 max-w-lg">
      Click on any learning track below to explore the detailed roadmap of scheduled blogs, technical breakdowns, and reproducible lab exercises.
    </p>
  </div>

  <div class="kube-roadmap-tracks">
    <%= for {track, index} <- Enum.with_index(@roadmap, 1) do %>
      <details class="kube-roadmap-track" open={index == 1}>
        <summary>
          <span class="kube-roadmap-track-number">0{index}</span>
          <div class="kube-roadmap-track-copy">
            <strong>{track.title}</strong>
            <small>{track.description}</small>
          </div>
          <span class="kube-roadmap-track-count">
            {track.blogs} blogs &middot; {track.labs} labs
          </span>
          <span class="kube-roadmap-track-toggle" aria-hidden="true">+</span>
        </summary>
        <div class="kube-roadmap-track-body">
          <div>
            <span class="kube-kicker block mb-2">
              {track.blogs} Planned Articles &amp; Architecture Guides
            </span>
            <ol class="kube-roadmap-title-list">
              <%= for title <- track.blog_titles do %>
                <li>{title}</li>
              <% end %>
            </ol>
          </div>
          <div>
            <span class="kube-kicker block mb-2">
              {track.labs} Planned Hands-on Exercises
            </span>
            <ol class="kube-roadmap-title-list">
              <%= for title <- track.lab_titles do %>
                <li>{title}</li>
              <% end %>
            </ol>
          </div>
        </div>
      </details>
    <% end %>
  </div>
</section>

<!-- Community Suggestion Footer -->
<section class="border-t border-slate-200 [data-theme=dark]:border-slate-800 bg-slate-100/50 [data-theme=dark]:bg-slate-900/40 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="kube-contribute p-8 sm:p-12 rounded-2xl border border-slate-200 bg-white [data-theme=dark]:border-slate-800 [data-theme=dark]:bg-slate-900 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-2 max-w-2xl">
        <span class="kube-kicker">Propose a Topic</span>
        <h3 class="text-2xl font-bold text-slate-900 [data-theme=dark]:text-white">
          Want a specific lab or guide written?
        </h3>
        <p class="text-sm text-slate-600 [data-theme=dark]:text-slate-400 leading-relaxed">
          Open a GitHub issue with the title or tool you would like added to the foundation curriculum.
        </p>
      </div>
      <a
        href="https://github.com/aidatafoundation/aidatafoundation.github.io/issues/new"
        target="_blank"
        rel="noopener noreferrer"
        class="kube-button text-sm shrink-0"
      >
        Suggest a Roadmap Title &nearr;
      </a>
    </div>
  </div>
</section>
