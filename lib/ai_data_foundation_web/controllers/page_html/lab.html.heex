<!-- AI Data Foundation Lab Reader Header -->
<div class="kube-lab-reader-header" id="reader-top">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="kube-lab-breadcrumb" aria-label="Breadcrumb">
      <a href="/labs">Labs</a>
      <span aria-hidden="true">/</span>
      <span>{@lab["category"]}</span>
    </nav>
    <span class="kube-kicker">Interactive Runbook</span>
    <h1>{@lab["title"]}</h1>
    <p class="text-lg text-slate-600 [data-theme=dark]:text-slate-300 max-w-3xl leading-relaxed mt-2">
      {@lab["description"]}
    </p>
    <div class="kube-tag-list mt-4">
      <%= for tag <- @lab["tags"] || [] do %>
        <span class="kube-tag">{tag}</span>
      <% end %>
    </div>
  </div>
</div>

<!-- Three-Step Execution Guide -->
<div class="kube-lab-steps">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <ol>
      <li>
        <span>1</span>
        <div>
          <strong>Read the Concept</strong>
          <small>Understand the architecture first</small>
        </div>
      </li>
      <li>
        <span>2</span>
        <div>
          <strong>Execute the Code</strong>
          <small>Run in your local sandbox</small>
        </div>
      </li>
      <li>
        <span>3</span>
        <div>
          <strong>Evaluate &amp; Extend</strong>
          <small>Benchmark and inspect output</small>
        </div>
      </li>
    </ol>
  </div>
</div>

<!-- Reader Shell with Sticky Sidebar & Markdown -->
<div class="kube-lab-reader-shell">
  <aside class="kube-lab-outline" aria-label="Lab contents and navigation">
    <details class="kube-reader-contents" open>
      <summary>
        <span>On this page</span>
        <span class="text-xs font-normal text-slate-400">({length(@outline)})</span>
      </summary>
      <nav>
        <%= for item <- @outline do %>
          <a
            class={if(item.level == 3, do: "kube-reader-nested", else: "")}
            href={"##{item.id}"}
          >
            {item.title}
          </a>
        <% end %>
      </nav>
    </details>

    <button type="button" class="kube-reading-toggle" data-reading-toggle hidden>
      Reading width: <span>standard</span>
    </button>

    <a href="/labs" class="kube-lab-outline-all">
      &larr; All hands-on labs
    </a>
    <a
      href={@edit_url}
      target="_blank"
      rel="noopener noreferrer"
      class="kube-contribute-link"
    >
      Edit this lab on GitHub &nearr;
    </a>
  </aside>

  <div class="min-w-0">
    <div class="kube-lab-reading-note">
      <strong>Prerequisites:</strong>
      Ensure you have Python 3.10+ or Docker installed. Run all commands inside a disposable virtual environment or container.
    </div>

    <article class="kube-markdown">
      {raw(@content)}
    </article>

    <div class="kube-reader-end">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <a
          href="#reader-top"
          class="text-sm font-bold text-violet-600 [data-theme=dark]:text-violet-400 hover:underline"
        >
          &uarr; Back to top
        </a>
        <a
          href="/labs"
          class="text-sm font-bold text-violet-600 [data-theme=dark]:text-violet-400 hover:underline"
        >
          Explore more labs &rarr;
        </a>
      </div>
    </div>
  </div>
</div>
