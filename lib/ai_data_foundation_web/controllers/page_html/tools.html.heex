<!-- AI Data Foundation Tools Hero -->
<section class="kube-tools-hero">
  <div class="max-w-7xl mx-auto px-4 py-16 sm:py-24 sm:px-6 lg:px-8 relative z-10">
    <div class="kube-tools-hero-copy max-w-4xl">
      <span class="kube-label">
        Curated Index
      </span>
      <h1>
        Explore the tools that power <span>modern AI systems.</span>
      </h1>
      <p>
        Browse 500+ curated open-source AI projects across Large Language Models, Model Context Protocol (MCP) servers, vector databases, synthetic data generation, and evaluation frameworks.
      </p>
      <div class="mt-8">
        <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="kube-tools-star"
        >
          <span class="text-amber-400 font-bold text-xl">&starf;</span>
          <div>
            <strong id="kube-github-stars">Star AI Data Foundation on GitHub</strong>
            <small>Community supported &middot; Open source under Apache-2.0</small>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Tools Directory Section -->
<section class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
  <div class="kube-tools-directory-heading flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <span class="kube-kicker">Interactive Catalog</span>
      <h2 class="text-3xl font-black tracking-tight text-slate-900 [data-theme=dark]:text-white mt-1">
        Directory Catalog
      </h2>
    </div>
    <p class="text-sm text-slate-500 max-w-md">
      Filter by category, search by keywords, or sort by name. The URL updates automatically to make your query shareable.
    </p>
  </div>

  <div id="kube-tools" class="min-h-[400px]">
    <div class="py-20 text-center text-slate-500">
      <div class="inline-block w-8 h-8 border-4 border-violet-600 border-t-transparent rounded-full animate-spin mb-4">
      </div>
      <p>Loading AI tools directory...</p>
    </div>
  </div>

  <noscript>
    <div class="p-8 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 [data-theme=dark]:border-amber-800 [data-theme=dark]:bg-amber-950/40 [data-theme=dark]:text-amber-200">
      <h3 class="font-bold text-lg mb-2">JavaScript Required for Interactive Filtering</h3>
      <p>
        Please enable JavaScript to search and filter the live tools directory, or view our <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io"
          class="underline font-semibold"
        >tool entries directly on GitHub</a>.
      </p>
    </div>
  </noscript>

  <script type="module" src="/aidatafoundation/tools.js">
  </script>
</section>

<!-- Contribution Section for AI Data Foundation -->
<section class="border-t border-slate-200 [data-theme=dark]:border-slate-800 bg-slate-100/50 [data-theme=dark]:bg-slate-900/40 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="kube-contribute p-8 sm:p-12 rounded-2xl border border-slate-200 bg-white [data-theme=dark]:border-slate-800 [data-theme=dark]:bg-slate-900 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-2 max-w-2xl">
        <span class="kube-kicker">Expand the Ecosystem</span>
        <h3 class="text-2xl font-bold text-slate-900 [data-theme=dark]:text-white">
          Know an open AI tool that should be listed?
        </h3>
        <p class="text-sm text-slate-600 [data-theme=dark]:text-slate-400 leading-relaxed">
          Submit a pull request to add your open-source model, MCP server, embedding pipeline, or evaluation benchmark to the foundation directory.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="kube-button text-sm"
        >
          Contribution Guide &rarr;
        </a>
        <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io/issues/new"
          target="_blank"
          rel="noopener noreferrer"
          class="kube-button kube-button-outline text-sm"
        >
          Recommend a Tool &nearr;
        </a>
      </div>
    </div>
  </div>
</section>
