<div data-content-library>
  <!-- AI Data Foundation Workshop Header -->
  <section class="kube-library-header">
    <div class="kube-library-container">
      <span class="kube-kicker">Interactive Practice</span>
      <h1>
        Less theory. <span>More hands-on understanding.</span>
      </h1>
      <p class="kube-library-intro">
        Hands-on technical tutorials for artificial intelligence engineers. Run local models with Ollama, connect Weaviate vector databases, orchestrate LangChain agent workflows, and evaluate benchmarks.
      </p>
      <div class="kube-library-links">
        <a href="#featured">Browse {length(@labs)} self-paced labs &darr;</a>
        <a href="/roadmap">View editorial roadmap &rarr;</a>
        <a href="/blog">Read engineering notes &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Labs Catalog Section -->
  <div class="kube-library-section">
    <div class="kube-library-container">
      <div class="kube-library-toolbar" id="featured">
        <div>
          <span class="kube-kicker">Self-Paced Runbooks</span>
          <h2>Choose your next lab</h2>
        </div>
        <div class="kube-library-search" data-library-controls>
          <label for="lab-library-search">Filter labs by title, topic, or command</label>
          <input
            id="lab-library-search"
            type="search"
            data-library-search
            placeholder="Search LangChain, Weaviate, RAG, Ollama…"
            autocomplete="off"
          />
        </div>
      </div>

      <p class="kube-library-count" data-library-count>
        {length(@labs)} of {length(@labs)} shown
      </p>

      <div class="kube-labs-grid">
        <%= for lab <- @labs do %>
          <article class="kube-lab-card" data-library-card>
            <div class="kube-lab-card-meta">
              <span class="kube-label">{lab["category"]}</span>
              <span class="text-xs font-mono text-slate-400">&gt;_ terminal</span>
            </div>
            <h3>
              <a href={~p"/labs/#{lab["id"]}"}>
                {lab["title"]}
              </a>
            </h3>
            <p>
              {lab["description"]}
            </p>
            <div class="kube-tag-list mb-4">
              <%= for tag <- lab["tags"] || [] do %>
                <span class="kube-tag">{tag}</span>
              <% end %>
            </div>
            <div class="kube-lab-card-footer pt-4 border-t border-slate-100 [data-theme=dark]:border-slate-800 flex items-center justify-between mt-auto">
              <span class="text-xs text-slate-500">By {Enum.join(
                lab["contributors"] || ["ADF"],
                ", "
              )}</span>
              <a
                href={~p"/labs/#{lab["id"]}"}
                class="text-sm font-bold text-violet-600 [data-theme=dark]:text-violet-400 hover:underline"
              >
                Open Lab &rarr;
              </a>
            </div>
          </article>
        <% end %>
      </div>

      <p class="py-12 text-center text-slate-500" data-library-empty hidden>
        No labs matched your search keyword. Clear your query to see all labs.
      </p>

      <!-- Good Practice Notice -->
      <div class="kube-library-practice mt-12 p-6 rounded-2xl border border-violet-200 bg-violet-50/50 [data-theme=dark]:border-violet-950 [data-theme=dark]:bg-violet-950/20 flex flex-col md:flex-row items-center gap-4">
        <div class="w-10 h-10 rounded-full bg-violet-600 text-white flex items-center justify-center font-bold text-lg shrink-0">
          !
        </div>
        <div class="text-sm text-slate-700 [data-theme=dark]:text-slate-300">
          <strong class="font-bold block mb-0.5 text-slate-900 [data-theme=dark]:text-white">A Good Lab Habit</strong>
          Always inspect code snippets before running them locally. Use isolated environments like Python virtualenvs (`python -m venv .venv`) or disposable Docker containers to keep your dependencies clean.
        </div>
      </div>

      <!-- Community Contribution Footer -->
      <div class="kube-library-footer mt-12 pt-8 border-t border-slate-200 [data-theme=dark]:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <span class="kube-kicker">Open Source</span>
          <h2 class="text-xl font-bold text-slate-900 [data-theme=dark]:text-white mt-1">
            Have an AI lab or notebook exercise to contribute?
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Submit a pull request to add your walkthrough to the foundation repository.
          </p>
        </div>
        <a
          href="https://github.com/aidatafoundation/aidatafoundation.github.io/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="kube-button text-sm shrink-0"
        >
          Contribute a Lab &rarr;
        </a>
      </div>
    </div>
  </div>
</div>
